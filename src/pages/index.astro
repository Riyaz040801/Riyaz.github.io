---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, socials, about, services, tools } from '../data/site';
import { projects, categories } from '../data/projects';
import heroImage from '../assets/work/3d/car-garage.png';
import profile from '../assets/site/profile.jpeg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeUrl = `${base}${site.resume}`;
const year = new Date().getFullYear();

// Full-size versions for the lightbox (never larger than the original).
const galleries = await Promise.all(
  projects.map(async (p) => ({
    title: p.title,
    images: await Promise.all(
      p.images.map(async ({ src, alt }) => {
        const img = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp', quality: 82 });
        return { src: img.src, alt, w: img.attributes.width, h: img.attributes.height };
      }),
    ),
  })),
);

---

<Base>
  <header class="topbar" id="top">
    <div class="container topbar-inner">
      <a href="#top" class="brand">{site.name}</a>
      <nav aria-label="Main">
        <ul>
          <li><a href="#work">Work</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
          <li class="hide-sm"><a class="btn btn-small" href={resumeUrl} download>Résumé</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[800, 1400, 2000, 2800]}
        sizes="100vw"
        alt=""
        class="hero-bg"
        loading="eager"
        fetchpriority="high"
      />
      <div class="container hero-content">
        <p class="eyebrow">{site.location}</p>
        <h1 id="hero-title">{site.name}</h1>
        <p class="hero-role">{site.role}</p>
        <p class="hero-lede">I build product renders, real-time environments and playable prototypes.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#work">View work</a>
          <a class="btn" href={resumeUrl} download>Download résumé</a>
        </div>
      </div>
    </section>

    <section id="work" class="section" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head">
          <h2 id="work-title">Selected work</h2>
          <div class="filters" role="group" aria-label="Filter projects">
            <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
            {
              categories.map((c) => (
                <button type="button" class="chip" data-filter={c.id} aria-pressed="false">
                  {c.label}
                </button>
              ))
            }
          </div>
        </div>

        <ul class="grid">
          {
            projects.map((p, i) => (
              <li class:list={['card', { wide: p.wide }]} data-category={p.category}>
                <button type="button" class="card-media" data-gallery={i} aria-label={`Open ${p.title} gallery`}>
                  <Picture
                    src={p.images[0].src}
                    formats={['avif', 'webp']}
        fallbackFormat="jpg"
                    widths={[480, 800, 1200]}
                    sizes={p.wide ? '(min-width: 1000px) 66vw, 100vw' : '(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw'}
                    alt={p.images[0].alt}
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                  {p.images.length > 1 && <span class="count">{p.images.length} images</span>}
                </button>
                <div class="card-body">
                  <h3>{p.title}</h3>
                  <p class="meta">
                    {p.tools.join(', ')}
                  </p>
                  <p class="summary">{p.summary}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="about" class="section section-alt" aria-labelledby="about-title">
      <div class="container about">
        <div class="about-photo">
          <Picture
            src={profile}
            formats={['avif', 'webp']}
        fallbackFormat="jpg"
            widths={[320, 640]}
            sizes="(min-width: 900px) 320px, 60vw"
            alt={`Portrait of ${site.name}`}
          />
        </div>
        <div class="about-text">
          <h2 id="about-title">About</h2>
          {about.map((p) => <p>{p}</p>)}
          <h3 class="small-head">Tools</h3>
          <ul class="tools">
            {tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>

      <div class="container">
        <h3 class="small-head services-head">What I do</h3>
        <ul class="services">
          {
            services.map((s) => (
              <li>
                <h4>{s.title}</h4>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-title">
      <div class="container contact">
        <div>
          <h2 id="contact-title">Let’s work together</h2>
          <p class="contact-lede">
            Open to full-time roles and freelance projects in 3D, product visualization and Unreal Engine.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
            <a class="btn" href={resumeUrl} download>Download résumé</a>
          </div>
          <ul class="socials">
            {
              socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer">
                    {s.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {
          site.formspreeId && (
            <form class="contact-form" action={`https://formspree.io/f/${site.formspreeId}`} method="POST">
              <label>
                Name
                <input type="text" name="name" autocomplete="name" required />
              </label>
              <label>
                Email
                <input type="email" name="email" autocomplete="email" required />
              </label>
              <label>
                Message
                <textarea name="message" rows="5" required />
              </label>
              <button type="submit" class="btn btn-primary">
                Send message
              </button>
            </form>
          )
        }
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <p>© {year} {site.name}</p>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>

  <dialog class="lightbox" aria-label="Image viewer">
    <div class="lb-bar">
      <p class="lb-title"></p>
      <p class="lb-count"></p>
      <button type="button" class="lb-close" aria-label="Close">✕</button>
    </div>
    <figure class="lb-figure">
      <img alt="" decoding="async" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="lb-nav lb-prev" aria-label="Previous image">‹</button>
    <button type="button" class="lb-nav lb-next" aria-label="Next image">›</button>
  </dialog>

  <script is:inline type="application/json" id="gallery-data" set:html={JSON.stringify(galleries)} />

  <script>
    type Img = { src: string; alt: string; w: number; h: number };
    type Gallery = { title: string; images: Img[] };

    // --- Filters ---
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const cards = document.querySelectorAll<HTMLElement>('.card');
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        cards.forEach((card) => {
          card.hidden = f !== 'all' && card.dataset.category !== f;
          card.classList.toggle('solo', f !== 'all');
        });
      }),
    );

    // --- Lightbox ---
    const galleries: Gallery[] = JSON.parse(document.getElementById('gallery-data')!.textContent || '[]');
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const title = dialog.querySelector('.lb-title')!;
    const count = dialog.querySelector('.lb-count')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;
    let current: Gallery | null = null;
    let index = 0;

    function show(i: number) {
      if (!current) return;
      const n = current.images.length;
      index = (i + n) % n;
      const item = current.images[index];
      img.src = item.src;
      img.alt = item.alt;
      img.width = item.w;
      img.height = item.h;
      caption.textContent = item.alt;
      count.textContent = n > 1 ? `${index + 1} / ${n}` : '';
      prev.hidden = next.hidden = n < 2;
      // Preload the neighbour so arrows feel instant.
      if (n > 1) new Image().src = current.images[(index + 1) % n].src;
    }

    document.querySelectorAll<HTMLButtonElement>('[data-gallery]').forEach((btn) =>
      btn.addEventListener('click', () => {
        current = galleries[Number(btn.dataset.gallery)];
        title.textContent = current.title;
        show(0);
        dialog.showModal();
      }),
    );

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => img.removeAttribute('src'));

    // Swipe on touch screens.
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  </script>
</Base>
