---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Page not found — Syed Riyaz N">
  <main id="main" class="section" style="min-height: 80vh; display: grid; place-items: center; text-align: center;">
    <div>
      <p class="eyebrow">404</p>
      <h1 style="font-size: clamp(2rem, 5vw, 3rem);">This page doesn’t exist</h1>
      <div class="hero-actions" style="justify-content: center;">
        <a class="btn btn-primary" href={base}>Back to portfolio</a>
      </div>
    </div>
  </main>
</Base>
