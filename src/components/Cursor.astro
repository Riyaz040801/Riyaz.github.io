---
// Custom cursor (dot + trailing ring) and 3D tilt for anything with [data-tilt].
// Mouse only — touch input keeps the normal behaviour, even on touchscreen laptops.
---

<div class="cursor-ring" aria-hidden="true"><span class="cursor-label"></span></div>
<div class="cursor-dot" aria-hidden="true"></div>

<script>
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine) {
    const root = document.documentElement;
    const ring = document.querySelector<HTMLElement>('.cursor-ring')!;
    const dot = document.querySelector<HTMLElement>('.cursor-dot')!;
    const label = ring.querySelector<HTMLElement>('.cursor-label')!;
    root.classList.add('has-cursor');

    let x = innerWidth / 2, y = innerHeight / 2, rx = x, ry = y, shown = false, raf = 0;

    // The ring eases toward the mouse, and the loop stops once it has caught up.
    const loop = () => {
      const k = still ? 1 : 0.18;
      rx += (x - rx) * k;
      ry += (y - ry) * k;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      raf = Math.abs(x - rx) + Math.abs(y - ry) > 0.2 ? requestAnimationFrame(loop) : 0;
    };

    addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        x = e.clientX;
        y = e.clientY;
        dot.style.transform = `translate(${x}px, ${y}px)`;
        if (!shown) {
          shown = true;
          rx = x;
          ry = y;
          root.classList.add('cursor-on');
        }
        if (!raf) raf = requestAnimationFrame(loop);
      },
      { passive: true },
    );
    root.addEventListener('pointerleave', () => root.classList.remove('cursor-on'));
    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse' && shown) root.classList.add('cursor-on');
    });
    addEventListener('pointerdown', (e) => e.pointerType === 'mouse' && ring.classList.add('down'));
    addEventListener('pointerup', () => ring.classList.remove('down'));

    // Grow the ring over clickable things; show a word over project cards.
    document.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse') return;
      const t = e.target as HTMLElement;
      const hot = t.closest<HTMLElement>('a, button, [data-cursor]');
      ring.classList.toggle('hot', !!hot);
      const word = hot?.dataset.cursor || '';
      label.textContent = word;
      ring.classList.toggle('labelled', !!word);
    });

    // 3D tilt: the element leans toward the cursor, with a moving light glare.
    if (!still) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
        const max = Number(el.dataset.tilt) || 8;
        let box: DOMRect | null = null; // measured once per hover, before the tilt changes it
        let pending = 0, px = 0.5, py = 0.5;
        const apply = () => {
          pending = 0;
          el.style.setProperty('--rx', `${(0.5 - py) * max}deg`);
          el.style.setProperty('--ry', `${(px - 0.5) * max}deg`);
          el.style.setProperty('--gx', `${px * 100}%`);
          el.style.setProperty('--gy', `${py * 100}%`);
        };
        el.addEventListener('pointerenter', (e) => {
          if (e.pointerType !== 'mouse') return;
          box = el.getBoundingClientRect();
          el.classList.add('tilting');
        });
        el.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          box ??= el.getBoundingClientRect();
          px = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width));
          py = Math.min(1, Math.max(0, (e.clientY - box.top) / box.height));
          if (!pending) pending = requestAnimationFrame(apply);
        });
        el.addEventListener('pointerleave', () => {
          box = null;
          cancelAnimationFrame(pending);
          pending = 0;
          el.style.setProperty('--rx', '0deg');
          el.style.setProperty('--ry', '0deg');
          el.classList.remove('tilting');
        });
      });
      // Page scroll moves cards under a still mouse: re-measure on the next move.
      addEventListener('scroll', () => document.querySelectorAll<HTMLElement>('.tilting').forEach((el) => el.dispatchEvent(new PointerEvent('pointerenter', { pointerType: 'mouse' }))), { passive: true });
    }
  }
</script>
