---
interface Props {
  size?: number;
  class?: string;
}

const { size = 44, class: className } = Astro.props;

// Unique gradient id per instance so multiple logos on one page never clash.
const gradId = `rlogo-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  role="img"
  aria-label="Syed Riyaz N logo"
  class={className}
>
  <defs>
    <linearGradient id={gradId} x1="14" y1="12" x2="48" y2="56" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" />
      <stop offset=".55" stop-color="#d9d4c7" />
      <stop offset="1" stop-color="#8d8d8d" />
    </linearGradient>
  </defs>
  <!-- back face: thin offset outline gives the extruded / wireframe depth -->
  <path
    d="M22 48V12h12.5a9.5 9.5 0 0 1 0 19H22M33 31l13 17"
    stroke="#8d8d8d"
    stroke-width="1.25"
    stroke-opacity=".7"
    stroke-linejoin="round"
  />
  <!-- front face: stem + bowl -->
  <path d="M18 52V16h12.5a9.5 9.5 0 0 1 0 19H18" stroke={`url(#${gradId})`} stroke-width="5" />
  <!-- front face: leg, cut flat on the baseline -->
  <path d="M24.3 33h6.3l14.55 19h-6.3z" fill={`url(#${gradId})`} />
</svg>
