---
interface Props {
  size?: number;
  class?: string;
}

const { size = 44, class: className } = Astro.props;

// Unique def ids per instance so multiple logos on one page never clash.
const uid = Math.random().toString(36).slice(2, 9);
const gradId = `rlogo-g-${uid}`;
const clipId = `rlogo-c-${uid}`;
const sheenId = `rlogo-s-${uid}`;

// Blade R: an italic, constant-weight R. One silver stroke launches from a
// knife-point tip, turns down through a single rounded corner, closes the bowl
// and kicks out the leg; a separate white stem slots under the blade along a
// parallel slit. The leg runs at the same 3/8 slope as the hover sheen.
const blade = 'M6.5 12h41c6.63 0 10.66 5.37 9 12l-3 12h-9l10 16h-13l-6-16h-8l2-8h18l1-4c.55-2.21-.79-4-3-4H17.83z';
const stem = 'M12.5 52l6.73-26.9 6.8 4.8L20.5 52z';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  role="img"
  aria-label="Syed Riyaz N logo"
  class:list={['rlogo', className]}
>
  <defs>
    <linearGradient id={gradId} x1="14" y1="12" x2="46" y2="52" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" />
      <stop offset=".45" stop-color="#e6dfd0" />
      <stop offset="1" stop-color="#8d8d8d" />
    </linearGradient>
    <linearGradient id={sheenId} x1="-6" y1="0" x2="0" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset=".5" stop-color="#fff" stop-opacity=".9" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <clipPath id={clipId}>
      <path d={blade} />
      <path d={stem} />
    </clipPath>
  </defs>
  <path d={blade} fill={`url(#${gradId})`} />
  <path d={stem} fill="#fff" />
  <!-- hover sheen: a band at the leg's angle, clipped to the mark -->
  <g clip-path={`url(#${clipId})`} aria-hidden="true">
    <path class="rlogo-sheen" d="M-6 0h6l24 64h-6z" fill={`url(#${sheenId})`} />
  </g>
</svg>

<style>
  .rlogo-sheen {
    opacity: 0;
    transform: translateX(-20px);
  }
  :global(a:hover) > .rlogo .rlogo-sheen,
  :global(a:focus-visible) > .rlogo .rlogo-sheen,
  .rlogo:hover .rlogo-sheen {
    opacity: 0.8;
    transform: translateX(62px);
    transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .rlogo-sheen,
    :global(a:hover) > .rlogo .rlogo-sheen,
    :global(a:focus-visible) > .rlogo .rlogo-sheen,
    .rlogo:hover .rlogo-sheen {
      opacity: 0;
      transition: none;
    }
  }
</style>
